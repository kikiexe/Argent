# Kredensial Proyek Supabase
# Salin file ini menjadi .env.local dan sesuaikan nilainya dengan dashboard proyek Anda.

# URL Proyek Supabase (Project URL - API Settings)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Kunci API Publik Anonim (Project API keys - anon/public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
